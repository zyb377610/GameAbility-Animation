class UniformFractureDataflowNode(DataflowNode):
	""" Editor Fracture Mode / Fracture / Uniform tool
	Fracture using a Voronoi diagram with a uniform random pattern, creating fracture pieces of similar volume across the shape.
	"""  # noqa

	Collection: ManagedArrayCollection
	""" Collection to fracture """  # noqa

	TransformSelection: DataflowTransformSelection
	""" Bones to fracture, if not connected it will fracture all the bones """  # noqa

	Transform: Transform
	""" Transform to apply """  # noqa

	MinVoronoiSites: int
	""" Minimum Number of Voronoi sites. The amount of sites per Voronoi diagram will be chosen at random between Min and Max """  # noqa

	MaxVoronoiSites: int
	""" Maximum Number of Voronoi sites. The amount of sites per Voronoi diagram will be chosen at random between Min and Max """  # noqa

	InternalMaterialID: int
	""" ID for the material for the newly created internal faces """  # noqa

	RandomSeed: int
	""" Random number generator seed for repeatability. If the value is -1, a different random seed will be used every time, otherwise the specified seed will always be used """  # noqa

	ChanceToFracture: float
	""" Chance to fracture each selected bone. If 0, no bones will fracture; if 1, all bones will fracture. """  # noqa

	GroupFracture: bool
	""" Generate a fracture pattern across all selected meshes. """  # noqa

	SplitIslands: bool
	""" Whether to split the fractured mesh pieces based on geometric connectivity after fracturing """  # noqa

	Grout: float
	""" Amount of space to leave between cut pieces """  # noqa

	Amplitude: float
	""" Size of the Perlin noise displacement (in cm). If 0, no noise will be applied """  # noqa

	Frequency: float
	""" Period of the Perlin noise.  Smaller values will create a smoother noise pattern """  # noqa

	Persistence: float
	""" Persistence of the layers of Perlin noise. At each layer (octave) after the first, the amplitude of the Perlin noise is scaled by this factor """  # noqa

	Lacunarity: float
	""" Lacunarity of the layers of Perlin noise. At each layer (octave) after the first, the frequency of the Perlin noise is scaled by this factor """  # noqa

	OctaveNumber: int
	""" Number of fractal layers of Perlin noise to apply. Each layer is additive, with Amplitude and Frequency parameters scaled by Persistence and Lacunarity
	Smaller values (1 or 2) will create noise that looks like gentle rolling hills, while larger values (> 4) will tend to look more like craggy mountains
	"""  # noqa

	PointSpacing: float
	""" Distance (in cm) between vertices on cut surfaces where noise is added.  Larger spacing between vertices will create more efficient meshes with fewer triangles, but less resolution to see the shape of the added noise """  # noqa

	AddSamplesForCollision: bool
	""" If enabled, add extra vertices (without triangles) to the geometry in regions where vertices are spaced too far apart (e.g. across large triangles)
	These extra vertices will be used as collision samples in particle-implicit collisions, and can help the physics system detect collisions more accurately

	Note this is *only* useful for simulations that use particle-implicit collisions
	"""  # noqa

	CollisionSampleSpacing: float
	""" The number of centimeters to allow between vertices on the mesh surface: If there are gaps larger than this, add additional vertices (without triangles) to help support particle-implicit collisions
	Only used if Add Samples For Collision is enabled
	"""  # noqa

	NewGeometryTransformSelection: DataflowTransformSelection
	""" Fractured Pieces """  # noqa

	pass

