	bOrientZAxisTowardCamera: bool
	""" If true, the system's Z axis will be oriented toward the camera """  # noqa

	bUseFixedRelativeBoundingBox: bool
	""" Whether to use the fixed relative bounding box or calculate it every frame. """  # noqa

