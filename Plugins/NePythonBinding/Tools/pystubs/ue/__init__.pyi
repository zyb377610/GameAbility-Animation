class CameraModifier(Object):
	""" A CameraModifier is a base class for objects that may adjust the final camera properties after
	being computed by the APlayerCameraManager (See: ModifyCamera). A CameraModifier
	can be stateful, and is associated uniquely with a specific APlayerCameraManager.
	"""  # noqa

	bDebug: bool
	""" If true, enables certain debug visualization features. """  # noqa

	bExclusive: bool
	""" If true, no other modifiers of same priority allowed. """  # noqa

	Priority: int
	""" Priority value that determines the order in which modifiers are applied. 0 = highest priority, 255 = lowest. """  # noqa

	CameraOwner: PlayerCameraManager
	""" Camera this object is associated with. """  # noqa

	AlphaInTime: float
	""" When blending in, alpha proceeds from 0 to 1 over this time """  # noqa

	AlphaOutTime: float
	""" When blending out, alpha proceeds from 1 to 0 over this time """  # noqa

	Alpha: float
	""" Current blend alpha. """  # noqa

	def EnableModifier(self)-> None:
		""" Enables this modifier. """  # noqa
		pass

	def DisableModifier(self, bImmediate: bool = False)-> None:
		""" Disables this modifier.
		@param  bImmediate  - true to disable with no blend out, false (default) to allow blend out
		"""  # noqa
		pass

	def GetViewTarget(self) -> Actor:
		""" @return Returns the actor the camera is currently viewing. """  # noqa
		pass

	def IsPendingDisable(self) -> bool:
		""" @return Returns true if modifier is pending disable, false otherwise. """  # noqa
		pass

	def IsDisabled(self) -> bool:
		""" @return Returns true if modifier is disabled, false otherwise. """  # noqa
		pass

	@typing.type_check_only
	def BlueprintModifyPostProcess(self, DeltaTime: float) -> tuple[float, PostProcessSettings]:
		""" Called per tick that the modifier is active to allow Blueprinted modifiers to modify the camera's postprocess effects.
		Scaling by Alpha happens after this in code, so no need to deal with that in the blueprint.
		@param       DeltaTime                               Change in time since last update
		@param       PostProcessBlendWeight  (out) Blend weight applied to the entire postprocess structure.
		@param       PostProcessSettings             (out) Post process structure defining what settings and values to override.
		"""  # noqa
		pass

	@typing.type_check_only
	def BlueprintModifyCamera(self, DeltaTime: float, ViewLocation: Vector, ViewRotation: Rotator, FOV: float) -> tuple[Vector, Rotator, float]:
		""" Called per tick that the modifier is active to allow Blueprinted modifiers to modify the camera's transform.
		Scaling by Alpha happens after this in code, so no need to deal with that in the blueprint.
		@param       DeltaTime       Change in time since last update
		@param       ViewLocation            The current camera location.
		@param       ViewRotation            The current camera rotation.
		@param       FOV                                     The current camera fov.
		@param       NewViewLocation         (out) The modified camera location.
		@param       NewViewRotation         (out) The modified camera rotation.
		@param       NewFOV                          (out) The modified camera FOV.
		"""  # noqa
		pass

	def OnCameraOwnerDestroyed(self, InOwner: Actor | None)-> None:
		pass

	pass

