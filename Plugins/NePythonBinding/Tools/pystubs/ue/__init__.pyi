class TextureSource(StructBase):
	""" Texture source data management. """  # noqa

	Id: Guid
	""" GUID used to track changes to the source data.
	      Typically with UseHashAsGuid , this 'Id' is the hash of the BulkData.
	      Note that GetId() is not == Id.
	"""  # noqa

	BaseBlockX: int
	""" Position of texture block0, only relevant if source has multiple blocks """  # noqa

	BaseBlockY: int

	SizeX: int
	""" Width of the texture. """  # noqa

	SizeY: int
	""" Height of the texture. """  # noqa

	NumSlices: int
	""" Depth (volume textures) or faces (cube maps). """  # noqa

	NumMips: int
	""" Number of mips provided as source data for the texture. """  # noqa

	NumLayers: int
	""" Number of layers (for multi-layered virtual textures) provided as source data for the texture. """  # noqa

	bLongLatCubemap: bool
	""" Source represents a cubemap in long/lat format, will have only 1 slice per cube, rather than 6 slices.
	Not needed for non-array cubemaps, since we can just look at NumSlices == 1 or 6
	But for cube arrays, no way of determining whether NumSlices=6 means 1 cubemap, or 6 long/lat cubemaps
	"""  # noqa

	CompressionFormat: ETextureSourceCompressionFormat
	""" Compression format that source data is stored as. """  # noqa

	bGuidIsHash: bool
	""" Uses hash instead of guid to identify content to improve DDC cache hit. """  # noqa

	LayerColorInfo_LockProtected: ArrayWrapper[TextureSourceLayerColorInfo]
	""" Per layer color info. If this is empty we don't have the data, otherwise count is == NumLayers.
	      Protected by BulkDataLock for thread safety.  Use Get/Set accessors which do the locking for you.
	"""  # noqa

	Format: ETextureSourceFormat
	""" Format in which the source data is stored. """  # noqa

	LayerFormat: ArrayWrapper[ETextureSourceFormat]
	""" For multi-layered sources, each layer may have a different format (in this case LayerFormat[0] == Format) . """  # noqa

	Blocks: ArrayWrapper[TextureSourceBlock]
	""" All sources have 1 implicit block defined by BaseBlockXY/SizeXY members.  Textures imported as UDIM may have additional blocks defined here.
	These are stored sequentially in the source's bulk data.
	"""  # noqa

	BlockDataOffsets: ArrayWrapper[int]
	""" Offsets of each block (including Block0) in the bulk data.
	Blocks are not necessarily stored in order, since block indices are sorted by X/Y location.
	For non-UDIM textures, this will always have a single entry equal to 0
	"""  # noqa

	pass

