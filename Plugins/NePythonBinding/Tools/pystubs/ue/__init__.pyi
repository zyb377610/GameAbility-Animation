class EditorActorSubsystem(EditorSubsystem):
	""" UEditorActorUtilitiesSubsystem
	Subsystem for exposing actor related utilities to scripts,
	"""  # noqa

	OnNewActorsDropped: DynamicMulticastDelegateWrapper[[list[Object], list[Actor]], None]

	OnNewActorsPlaced: DynamicMulticastDelegateWrapper[[Object, list[Actor]], None]

	OnEditCutActorsBegin: DynamicMulticastDelegateWrapper[[], None]

	OnEditCutActorsEnd: DynamicMulticastDelegateWrapper[[], None]

	OnEditCopyActorsBegin: DynamicMulticastDelegateWrapper[[], None]

	OnEditCopyActorsEnd: DynamicMulticastDelegateWrapper[[], None]

	OnEditPasteActorsBegin: DynamicMulticastDelegateWrapper[[], None]

	OnEditPasteActorsEnd: DynamicMulticastDelegateWrapper[[], None]

	OnDuplicateActorsBegin: DynamicMulticastDelegateWrapper[[], None]

	OnDuplicateActorsEnd: DynamicMulticastDelegateWrapper[[], None]

	OnDeleteActorsBegin: DynamicMulticastDelegateWrapper[[], None]

	OnDeleteActorsEnd: DynamicMulticastDelegateWrapper[[], None]

	OnActorLabelChanged: DynamicMulticastDelegateWrapper[[Actor], None]

	def SetComponentTransform(self, InSceneComponent: SceneComponent | None, InWorldTransform: Transform) -> bool:
		""" Sets the world transform of the given component, if possible.
		@returns false if the world transform could not be set.
		"""  # noqa
		pass

	def SetActorTransform(self, InActor: Actor | None, InWorldTransform: Transform) -> bool:
		""" Sets the world transform of the given actor, if possible.
		@returns false if the world transform could not be set.
		"""  # noqa
		pass

	def ConvertActors[T: Actor](self, Actors: list[Actor], ActorClass: TSubclassOf[T] | type[T] | None, StaticMeshPackagePath: str) -> list[T]:
		""" Replace in the level all Actors provided with a new actor of type ActorClass. Destroy all Actors provided.
		@param       Actors                                  List of Actors to replace.
		@param       ActorClass                              Class/Blueprint of the new actor that will be spawn.
		@param       StaticMeshPackagePath   If the list contains Brushes and it is requested to change them to StaticMesh, StaticMeshPackagePath is the package path to where the StaticMesh will be created. ie. /Game/MyFolder/
		"""  # noqa
		pass

	def DestroyActors(self, ActorsToDestroy: list[Actor]) -> bool:
		""" Destroy the actors from the world editor. Notify the Editor that the actor got destroyed.
		@param        ActorsToDestroy         Actors to destroy.
		@return       True if the operation succeeds.
		"""  # noqa
		pass

	def DestroyActor(self, ActorToDestroy: Actor | None) -> bool:
		""" Destroy the actor from the world editor. Notify the Editor that the actor got destroyed.
		@param       ActorToDestroy  Actor to destroy.
		@return      True if the operation succeeds.
		"""  # noqa
		pass

	def SpawnActorFromClass[T: Actor](self, ActorClass: TSubclassOf[T] | type[T] | None, Location: Vector, Rotation: Rotator = Rotator(), bTransient: bool = False) -> T:
		""" Create an actor and place it in the world editor. Can be created from a Blueprint or a Class.
		The actor will be created in the current level and will be selected.
		@param       ActorClass              Asset to attempt to use for an actor to place.
		@param       Location                Location of the new actor.
		@return      The created actor.
		"""  # noqa
		pass

	def SpawnActorFromObject(self, ObjectToUse: Object | None, Location: Vector, Rotation: Rotator = Rotator(), bTransient: bool = False) -> Actor:
		""" Create an actor and place it in the world editor. The Actor can be created from a Factory, Archetype, Blueprint, Class or an Asset.
		The actor will be created in the current level and will be selected.
		@param       ObjectToUse             Asset to attempt to use for an actor to place.
		@param       Location                Location of the new actor.
		@return      The created actor.
		"""  # noqa
		pass

	def GetActorReference(self, PathToActor: str) -> Actor:
		""" Attempts to find the actor specified by PathToActor in the current editor world
		@param        PathToActor     The path to the actor (e.g. PersistentLevel.PlayerStart)
		@return       A reference to the actor, or none if it wasn't found
		"""  # noqa
		pass

	def SetActorSelectionState(self, Actor: Actor | None, bShouldBeSelected: bool)-> None:
		""" Set the selection state for the selected actor """  # noqa
		pass

	def SelectNothing(self)-> None:
		""" Selects nothing in the editor (another way to clear the selection) """  # noqa
		pass

	def ClearActorSelectionSet(self)-> None:
		""" Remove all actors from the selection set """  # noqa
		pass

	def SetSelectedLevelActors(self, ActorsToSelect: list[Actor])-> None:
		""" Clear the current world editor selection and select the provided actors. Exclude actor that are pending kill, in PIE, PreviewEditor, ...
		@param       ActorsToSelect  Actor that should be selected in the world editor.
		"""  # noqa
		pass

	def GetSelectedLevelActors(self) -> list[Actor]:
		""" Find all loaded Actors that are selected in the world editor. Exclude actor that are pending kill, in PIE, PreviewEditor, ...
		@param       ActorClass      Actor Class to find.
		@return      List of found Actors
		"""  # noqa
		pass

	def GetAllLevelActorsComponents(self) -> list[ActorComponent]:
		""" Find all loaded ActorComponent own by an actor in the world editor. Exclude actor that are pending kill, in PIE, PreviewEditor, ...
		@return      List of found ActorComponent
		"""  # noqa
		pass

	def GetAllLevelActors(self) -> list[Actor]:
		""" Find all loaded Actors in the world editor. Exclude actor that are pending kill, in PIE, PreviewEditor, ...
		@return      List of found Actors
		"""  # noqa
		pass

	def SelectAllChildren(self, bRecurseChildren: bool)-> None:
		""" Select all children actors of the current selection.

		@param   bRecurseChildren    True to recurse through all descendants of the children
		"""  # noqa
		pass

	def SelectAll(self, InWorld: World | None)-> None:
		""" Select all actors and BSP models in the given world, except those which are hidden
		 @param       InWorld         The world the actors are to be selected in.
		"""  # noqa
		pass

	def InvertSelection(self, InWorld: World | None)-> None:
		""" Invert the selection in the given world
		@param       InWorld         The world the selection is in.
		"""  # noqa
		pass

	def DeleteSelectedActors(self, InWorld: World | None)-> None:
		""" Delete all the selected actors in the given world
		@param       InWorld         The world the actors are selected in.
		"""  # noqa
		pass

	def DuplicateSelectedActors(self, InWorld: World | None)-> None:
		""" Duplicate all the selected actors in the given world
		@param       InWorld         The world the actors are selected in.
		"""  # noqa
		pass

	def DuplicateActors(self, ActorsToDuplicate: list[Actor], ToWorld: World | None = None, Offset: Vector = Vector()) -> list[Actor]:
		""" Duplicate actors from the world editor.
		@param       ActorsToDuplicate       Actors to duplicate.
		@param       ToWorld                         World to place the duplicated actors in.
		* @param     Offset                          Translation to offset duplicated actors by.
		@return      The duplicated actors, or empty if it didn't succeed
		"""  # noqa
		pass

	def DuplicateActor(self, ActorToDuplicate: Actor | None, ToWorld: World | None = None, Offset: Vector = Vector()) -> Actor:
		""" Duplicate an actor from the world editor.
		@param       ActorToDuplicate        Actor to duplicate.
		@param       ToWorld                         World to place the duplicated actor in.
		@param       Offset                          Translation to offset duplicated actor by.
		@return      The duplicated actor, or none if it didn't succeed
		"""  # noqa
		pass

	pass

class EditorAssetSubsystem(EditorSubsystem):
	""" UEditorAssetSubsystem
	Subsystem for exposing asset related utilities to scripts.
	Asset Paths can be represented in the following ways:
	             (Reference/Text Path)   StaticMesh'/Game/MyFolder/MyAsset.MyAsset'
	             (Full Name)                             StaticMesh /Game/MyFolder/MyAsset.MyAsset
	             (Path Name)                             /Game/MyFolder/MyAsset.MyAsset
	             (Package Name)                  /Game/MyFolder/MyAsset
	Directory Paths can be represented in the following ways:
	             /Game/MyNewFolder/
	             /Game/MyNewFolder
	"""  # noqa

	def SortByMetaData(self, Assets: list[AssetData], MetaDataTag: Name, MetaDataType: EEditorAssetMetaDataSortType, SortOrder: EEditorAssetSortOrder) -> tuple[bool, list[AssetData]]:
		""" Sorts the assets based on their meta data's type.
		Supported types: FString, int, float, FDateTime.

		@param Assets The assets to sort
		@param MetaDataTag The on which the sort is based
		@param MetaDataType The meta data type of MetaDataTag
		@param SortOrder Whether to sort ascending or descending
		@return Whether the data was sorted, e.g. false if not all assets have the MetaDataTag.
		"""  # noqa
		pass

	def GetAllAssetsByMetaDataTags(self, RequiredTags: set[Name], AllowedClasses: set[Class]) -> list[AssetData]:
		""" Gets all assets which have the given tags.

		@params RequiredTags The tags the assets should have
		@params AllowedClasses The class types the contained assets should have
		"""  # noqa
		pass

	def RemoveOnExtractAssetFromFile(self, Delegate: typing.Callable[[list[str]], list[AssetData]])-> None:
		""" Call this to remove a callback added with AddOnExtractAssetFromFile. """  # noqa
		pass

	def AddOnExtractAssetFromFile(self, Delegate: typing.Callable[[list[str]], list[AssetData]])-> None:
		""" Call this to add a callback to extract an asset from a file,
		for example from a drag and drop operation.
		"""  # noqa
		pass

	@typing.type_check_only
	def OnExtractAssetFromFileDynamic__DelegateSignature(self, Files: list[str]) -> list[AssetData]:
		""" Dynamic version of FOnExtractAssetFromFile. """  # noqa
		pass

	def RemoveMetadataTag(self, Object: Object | None, Tag: Name)-> None:
		""" Remove the given tag from a loaded asset's metadata.
		@param  Object          The object from which to retrieve the metadata.
		@param  Tag                     The tag to remove from the metadata.
